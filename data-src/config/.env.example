############# Confluence Config #################
# Your Confluence API bearer token
confluence_token=YOUR_CONFLUENCE_TOKEN_HERE

############# Provided Confluence Root Link #################
# The root Confluence page URL to start fetching from
# You can add multiple URLs, one per line after CONFLUENCE_ROOT_LINK=
CONFLUENCE_ROOT_LINK=
https://confluence.samsungds.net/spaces/your-space/pages/your-page-id
https://confluence.samsungds.net/spaces/another-space/pages/another-page-id

# Set to ON to fetch Jira ticket information, OFF to skip
FETCH_JIRA_INFO=OFF

############# Jira Config #######################
# Your Jira API tokens for different instances
mlm_jira_token=YOUR_MLM_JIRA_TOKEN_HERE
ssir_jira_token=YOUR_SSIR_JIRA_TOKEN_HERE
ted_jira_token=YOUR_TED_JIRA_TOKEN_HERE

############# Output Configuration ###############
# Directory name where output files will be saved
OUTPUT_DIR=OutputDirectoryName

# How many levels deep to fetch Confluence pages (recommended: 3-10)
DEPTH=5
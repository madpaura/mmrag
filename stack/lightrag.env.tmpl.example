# ── Server ──
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE=__WEBUI_TITLE__
WEBUI_DESCRIPTION='Multimodal RAG System with Knowledge Graph'

# ── LLM → qwen3.8-flash-next via LiteLLM (Samsung LLM gateway) ──
LLM_BINDING=openai
LLM_MODEL=qwen3.8-flash-next
LLM_BINDING_HOST=http://host.docker.internal:4000/v1
LLM_BINDING_API_KEY=__LITELLM_API_KEY__
LLM_TIMEOUT=3600
MAX_ASYNC=24
MAX_ASYNC_LLM=24
EMBEDDING_FUNC_MAX_ASYNC=16
MAX_GLEANING=1
TIMEOUT=300
EXTRACT_LLM_MODEL=qwen3-30b-a3b
EXTRACT_MAX_ASYNC_LLM=24
EXTRACT_LLM_TIMEOUT=600
SUMMARY_LLM_MODEL=qwen3.8-flash-next
ENTITY_EXTRACTION_USE_JSON=true

# ── VLM → flash-next on spark41 ──
VLM_PROCESS_ENABLE=true
VLM_LLM_MODEL=qwen3.8-flash-next
VLM_MAX_ASYNC_LLM=4

# ── Embedding → Ollama bge-m3 via LiteLLM ──
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BINDING_HOST=http://host.docker.internal:4000/v1
EMBEDDING_BINDING_API_KEY=__LITELLM_API_KEY__

# ── PostgreSQL (PGVector + KV) ──
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=raguser
POSTGRES_PASSWORD=__GENERATED__
POSTGRES_DATABASE=raganything

# ── Neo4j (Graph) ──
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=__GENERATED__

# ── File Processing Pipeline (v1.5.7) ──
#LIGHTRAG_PARSER=*:mineru-iteP,*:legacy-R
LIGHTRAG_PARSER=*:mineru-iteR,*:legacy-R
MINERU_API_MODE=local
MINERU_LOCAL_ENDPOINT=http://host.docker.internal:8000
MINERU_LOCAL_IMAGE_ANALYSIS=false
MAX_PARALLEL_PARSE_MINERU=2

# ── Performance Tuning ──
MAX_PARALLEL_INSERT=8
FORCE_LLM_SUMMARY_ON_MERGE=12
CHUNK_SIZE=1200
CHUNK_P_SIZE=1200
CHUNK_P_OVERLAP_SIZE=100
CHUNK_OVERLAP_SIZE=100
OPENAI_LLM_TEMPERATURE=0.2
EXTRACT_OPENAI_LLM_TEMPERATURE=0.2
#OPENAI_LLM_MAX_TOKENS=128
EXTRACT_OPENAI_LLM_MAX_TOKENS=3072
QUERY_OPENAI_LLM_MAX_TOKENS=4096
SUMMARY_OPENAI_LLM_MAX_TOKENS=4096
VLM_OPENAI_LLM_MAX_TOKENS=2048
KEYWORD_OPENAI_LLM_MAX_TOKENS=2048
OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
EMBEDDING_BATCH_NUM=64
MAX_EXTRACTION_RECORDS=100
MAX_EXTRACTION_ENTITIES=50
ENABLE_LLM_CACHE=false
ENABLE_LLM_CACHE_FOR_EXTRACT=true

# ── RAG Query ──
TOP_K=60
CHUNK_TOP_K=12

# ── Language ──
SUMMARY_LANGUAGE=English

# ── Directories ──
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
PROMPT_DIR=/app/data/prompts

# ── MinerU ──
MINERU_MAX_POLLS=3600
MINERU_POLL_INTERVAL_SECONDS=3

# Copy to config/global.env — read by setup.sh
BASE_URL=http://mydomain.com
URL_ROOT=/mmrag                       # projects live at $BASE_URL$URL_ROOT/<proj>/{api,mgmt}
NGINX_CONF_DIR=/etc/nginx/mmrag.d     # one <proj>.conf per project; include it from your server block
NGINX_RELOAD=1                        # 0 = don't run `nginx -t && nginx -s reload`
LITELLM_URL=http://localhost:4000     # prerequisite check only; LightRAG uses the hosts in stack/lightrag.env.tmpl
PORT_BASE=19600                       # first localhost port handed out to projects
